@page "{id}"
@using WebApp.Pages.Incidents
@model DetailsModel
@{
    ViewData["Title"] = "Incident Details";
}

<div class="page-header">
    <div class="container-wide">
        <h1>Incident Details</h1>
        <p class="subtitle">View incident report</p>
    </div>
</div>

<main class="container-wide">
    @if (Model.Incident == null)
    {
        <div class="alert alert-error">
            <p>Incident not found.</p>
        </div>
    }
    else
    {
        <div style="background: white; border: 1px solid #d0d7de; border-radius: 6px; padding: 24px; max-width: 600px;">
            <dl style="display: grid; grid-template-columns: 150px 1fr; gap: 16px;">
                <dt style="font-weight: 600;">ID:</dt>
                <dd>@Model.Incident.Id</dd>

                <dt style="font-weight: 600;">Date:</dt>
                <dd>@Model.Incident.Date.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt style="font-weight: 600;">Type:</dt>
                <dd>@Model.Incident.IncidentType</dd>

                <dt style="font-weight: 600;">Area:</dt>
                <dd>@Model.Incident.Area</dd>

                <dt style="font-weight: 600;">Sub Area:</dt>
                <dd>@Model.Incident.SubArea</dd>

                <dt style="font-weight: 600;">Watch:</dt>
                <dd>@Model.Incident.Watch</dd>

                <dt style="font-weight: 600;">Operator:</dt>
                <dd>@Model.Incident.Operator</dd>

                <dt style="font-weight: 600;">Description:</dt>
                <dd>@(Model.Incident.Description ?? "N/A")</dd>

                <dt style="font-weight: 600;">Action Taken:</dt>
                <dd>@(Model.Incident.Action ?? "N/A")</dd>

                <dt style="font-weight: 600;">Created:</dt>
                <dd>@Model.Incident.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>

                @if (Model.Incident.UpdatedAt.HasValue)
                {
                    <dt style="font-weight: 600;">Updated:</dt>
                    <dd>@Model.Incident.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                }
            </dl>

            <div class="btn-group">
                <a href="/Incidents/Edit/@Model.Incident.Id" class="btn btn-primary">Edit</a>
                <form method="post" style="display: inline;">
                    <button type="submit" class="btn btn-danger" 
                            onclick="return confirm('Are you sure you want to delete this incident?')">
                        Delete
                    </button>
                </form>
                <a href="/Incidents/Index" class="btn">Back to List</a>
            </div>
        </div>
    }
</main>
