@page
@using WebApp.Pages.Admin.Watches
@model WatchesIndexModel
@{
    ViewData["Title"] = "Manage Watches";
}

<div class="page-header">
    <div class="container-wide">
        <h1>Watches</h1>
        <p class="subtitle">Manage watch periods and shifts</p>
    </div>
</div>

<main class="container-wide">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div style="flex: 1;">
            <form method="get" style="display: flex; gap: 12px;">
                <input type="search" name="searchString" placeholder="Search watches..." 
                       value="@Model.SearchString" style="flex: 1; max-width: 300px;" />
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchString))
                {
                    <a href="/Admin/Watches/Index" class="btn">Clear</a>
                }
            </form>
        </div>
        <a href="/Admin/Watches/Create" class="btn btn-primary">+ New Watch</a>
    </div>

    @if (Model.Watches != null && Model.Watches.Any())
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var watch in Model.Watches)
                    {
                        <tr>
                            <td>@watch.Name</td>
                            <td>@(watch.Code ?? "-")</td>
                            <td>
                                <span class="status-badge @(watch.Active ? "active" : "inactive")">
                                    @(watch.Active ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <a href="/Admin/Watches/Edit?id=@watch.Id" class="btn btn-sm">Edit</a>
                                    <a href="/Admin/Watches/Index?handler=delete&id=@watch.Id" class="btn btn-sm btn-danger" 
                                       onclick="return confirm('Are you sure you want to delete this watch?');">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 40px; text-align: center; color: #666;">
            <p>No watches found. <a href="/Admin/Watches/Create">Create one</a></p>
        </div>
    }
</main>
