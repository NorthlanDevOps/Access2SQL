@page
@using WebApp.Pages.Admin.Watches
@model CreateModel
@{
    ViewData["Title"] = "Create Watch";
}

<div class="page-header">
    <div class="container-wide">
        <h1>Create Watch</h1>
        <p class="subtitle">Add a new watch period</p>
    </div>
</div>

<main class="container-wide">
    <div style="max-width: 600px;">
        <form method="post">
            <div class="form-group">
                <label asp-for="Watch.Name">Name *</label>
                <input asp-for="Watch.Name" type="text" required placeholder="e.g., Morning (6am-2pm)" />
                <span asp-validation-for="Watch.Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Watch.Code">Code</label>
                <input asp-for="Watch.Code" type="text" placeholder="e.g., MORN" />
                <span asp-validation-for="Watch.Code" class="validation-error"></span>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary">Create Watch</button>
                <a href="/Admin/Watches/Index" class="btn">Cancel</a>
            </div>
        </form>
    </div>
</main>
