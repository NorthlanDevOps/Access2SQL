@page
@using WebApp.Pages.Admin.Areas
@model CreateModel
@{
    ViewData["Title"] = "Create Area";
}

<div class="page-header">
    <div class="container-wide">
        <h1>Create Area</h1>
        <p class="subtitle">Add a new geographic area</p>
    </div>
</div>

<main class="container-wide">
    <div style="max-width: 600px;">
        <form method="post">
            <div class="form-group">
                <label asp-for="Area.Name">Name *</label>
                <input asp-for="Area.Name" type="text" required placeholder="e.g., North Zone" />
                <span asp-validation-for="Area.Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Area.Code">Code</label>
                <input asp-for="Area.Code" type="text" placeholder="e.g., NZ" />
                <span asp-validation-for="Area.Code" class="validation-error"></span>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary">Create Area</button>
                <a href="/Admin/Areas/Index" class="btn">Cancel</a>
            </div>
        </form>
    </div>
</main>
