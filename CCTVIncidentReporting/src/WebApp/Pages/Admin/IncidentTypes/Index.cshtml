@page
@using WebApp.Pages.Admin.IncidentTypes
@model IncidentTypesIndexModel
@{
    ViewData["Title"] = "Manage Incident Types";
}

<div class="page-header">
    <div class="container-wide">
        <h1>Incident Types</h1>
        <p class="subtitle">Manage incident categories and classifications</p>
    </div>
</div>

<main class="container-wide">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div style="flex: 1;">
            <form method="get" style="display: flex; gap: 12px;">
                <input type="search" name="searchString" placeholder="Search types..." 
                       value="@Model.SearchString" style="flex: 1; max-width: 300px;" />
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchString))
                {
                    <a href="/Admin/IncidentTypes/Index" class="btn">Clear</a>
                }
            </form>
        </div>
        <a href="/Admin/IncidentTypes/Create" class="btn btn-primary">+ New Type</a>
    </div>

    @if (Model.IncidentTypes != null && Model.IncidentTypes.Any())
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var type in Model.IncidentTypes)
                    {
                        <tr>
                            <td>@type.Name</td>
                            <td>@(type.Code ?? "-")</td>
                            <td>
                                <span class="status-badge @(type.Active ? "active" : "inactive")">
                                    @(type.Active ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <a href="/Admin/IncidentTypes/Edit?id=@type.Id" class="btn btn-sm">Edit</a>
                                    <a href="/Admin/IncidentTypes/Index?handler=delete&id=@type.Id" class="btn btn-sm btn-danger" 
                                       onclick="return confirm('Are you sure you want to delete this type?');">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 40px; text-align: center; color: #666;">
            <p>No incident types found. <a href="/Admin/IncidentTypes/Create">Create one</a></p>
        </div>
    }
</main>
