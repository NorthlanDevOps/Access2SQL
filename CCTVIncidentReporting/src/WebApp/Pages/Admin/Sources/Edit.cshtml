@page
@using WebApp.Pages.Admin.Sources
@model EditModel
@{
    ViewData["Title"] = "Edit Source";
}

<div class="page-header">
    <div class="container-wide">
        <h1>Edit Source</h1>
        <p class="subtitle">Update source details</p>
    </div>
</div>

<main class="container-wide">
    <div style="max-width: 600px;">
        <form method="post">
            <input type="hidden" asp-for="IncidentSource.Id" />

            <div class="form-group">
                <label asp-for="IncidentSource.Name">Name *</label>
                <input asp-for="IncidentSource.Name" type="text" required />
                <span asp-validation-for="IncidentSource.Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="IncidentSource.Code">Code</label>
                <input asp-for="IncidentSource.Code" type="text" />
                <span asp-validation-for="IncidentSource.Code" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" asp-for="IncidentSource.Active" />
                    Active
                </label>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/Admin/Sources/Index" class="btn">Cancel</a>
            </div>
        </form>
    </div>
</main>
