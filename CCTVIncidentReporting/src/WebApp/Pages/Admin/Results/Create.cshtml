@page
@using WebApp.Pages.Admin.Results
@model CreateModel
@{
    ViewData["Title"] = "Create Result";
}

<div class="page-header">
    <div class="container-wide">
        <h1>Create Result</h1>
        <p class="subtitle">Add a new incident outcome</p>
    </div>
</div>

<main class="container-wide">
    <div style="max-width: 600px;">
        <form method="post">
            <div class="form-group">
                <label asp-for="IncidentResult.Name">Name *</label>
                <input asp-for="IncidentResult.Name" type="text" required placeholder="e.g., Resolved, Pending, Escalated" />
                <span asp-validation-for="IncidentResult.Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="IncidentResult.Description">Description</label>
                <textarea asp-for="IncidentResult.Description" placeholder="Enter description..."></textarea>
                <span asp-validation-for="IncidentResult.Description" class="validation-error"></span>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary">Create Result</button>
                <a href="/Admin/Results/Index" class="btn">Cancel</a>
            </div>
        </form>
    </div>
</main>
